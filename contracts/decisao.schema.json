{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cp5/decisao.schema.json",
  "title": "Decisão consolidada do Supervisor",
  "description": "Resposta do webhook /cp5/avaliar e linha em decisoes. 'status_final' e 'acoes_previstas' são calculados por código (nó consolidar), não pelo LLM.",
  "type": "object",
  "required": [
    "id_leitura",
    "id_maquina",
    "ts",
    "status_guardrail",
    "status_llm",
    "status_final",
    "sensor_fault",
    "requer_humano",
    "especialistas",
    "resumo_operador",
    "justificativa",
    "acoes_previstas",
    "situacao",
    "problemas",
    "recomendacao"
  ],
  "additionalProperties": false,
  "properties": {
    "id_decisao": {
      "type": [
        "integer",
        "null"
      ]
    },
    "id_leitura": {
      "type": [
        "integer",
        "null"
      ]
    },
    "id_maquina": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "status_guardrail": {
      "$ref": "#/$defs/status"
    },
    "status_llm": {
      "$ref": "#/$defs/status_ou_nulo",
      "description": "null quando o LLM não foi chamado (ex.: sensor_fault) ou falhou"
    },
    "status_final": {
      "$ref": "#/$defs/status",
      "description": "max(status_llm, status_guardrail) pela ordem NORMAL < ATENCAO < CRITICO"
    },
    "sensor_fault": {
      "type": "boolean"
    },
    "requer_humano": {
      "type": "boolean",
      "description": "true se dados ausentes/inválidos, máquina desconhecida, sensor_fault ou algum especialista com dados_insuficientes"
    },
    "especialistas": {
      "type": "object",
      "required": [
        "manutencao",
        "producao",
        "energia"
      ],
      "additionalProperties": false,
      "properties": {
        "manutencao": {
          "oneOf": [
            {
              "$ref": "especialista.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "producao": {
          "oneOf": [
            {
              "$ref": "especialista.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "energia": {
          "oneOf": [
            {
              "$ref": "especialista.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "resumo_operador": {
      "type": "string",
      "maxLength": 500,
      "description": "Texto curto usado no Telegram"
    },
    "justificativa": {
      "type": "string",
      "maxLength": 2000,
      "description": "Raciocínio do supervisor, usado no e-mail e no card Trello"
    },
    "situacao": {
      "enum": [
        "NORMAL",
        "ALERTA"
      ],
      "description": "Visão do enunciado da CP5: ALERTA se status_final = CRITICO ou requer_humano; ATENCAO sozinho é pré-alerta (NORMAL)."
    },
    "problemas": {
      "type": "array",
      "description": "\"Problemas identificados\": violações CRÍTICAS do guardrail (textos de limiares.problemas), área escalada pelo LLM por tendência, ou dados inválidos.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "grandeza",
          "descricao",
          "valor",
          "limite"
        ],
        "properties": {
          "area": {
            "enum": [
              "manutencao",
              "producao",
              "energia",
              null
            ]
          },
          "grandeza": {
            "type": [
              "string",
              "null"
            ]
          },
          "descricao": {
            "type": "string"
          },
          "valor": {
            "type": [
              "number",
              "null"
            ]
          },
          "limite": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "recomendacao": {
      "type": "string",
      "maxLength": 500,
      "description": "Recomendação do supervisor LLM, ou a padrão por área (limiares.recomendacoes) quando o LLM não respondeu."
    },
    "relatorio": {
      "type": "string",
      "description": "Texto no formato do enunciado: Máquina / Situação / Problemas identificados / RECOMENDAÇÃO."
    },
    "acoes_previstas": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "TELEGRAM",
          "EMAIL",
          "TRELLO"
        ]
      },
      "description": "Derivado de limiares.acoes: TELEGRAM em todo ALERTA; EMAIL se há problema de energia ou produção; TRELLO se há problema mecânico (manutenção). Com requer_humano não há TRELLO (ordem de serviço exige dado confiável)."
    },
    "modelo": {
      "type": [
        "string",
        "null"
      ]
    },
    "latencia_ms": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "NORMAL",
        "ATENCAO",
        "CRITICO"
      ]
    },
    "status_ou_nulo": {
      "enum": [
        "NORMAL",
        "ATENCAO",
        "CRITICO",
        null
      ]
    }
  }
}
