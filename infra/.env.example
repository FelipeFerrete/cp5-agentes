# CP5 - Variáveis de ambiente (infra Docker)
# Copie este arquivo para `.env` e preencha com valores locais/reais.
# NUNCA versione o arquivo `.env` (veja .gitignore).

# ---------------------------------------------------------------------------
# Execução / segurança
# ---------------------------------------------------------------------------
# Com DRY_RUN=true as ações (Telegram/E-mail/Trello) gravam em `acoes_log`
# em vez de chamar as APIs externas. Use DRY_RUN=false só no smoke real (T18).
DRY_RUN=true

# ---------------------------------------------------------------------------
# LLM (Groq) - nomes de modelo ficam em env para troca rápida (decisão §8.2)
# ---------------------------------------------------------------------------
GROQ_MODEL_SUPERVISOR=openai/gpt-oss-120b
GROQ_MODEL_ESPECIALISTA=openai/gpt-oss-20b
# Modelo por especialista (opcional; vazio = GROQ_MODEL_ESPECIALISTA). No plano gratuito
# o limite de tokens por minuto é por modelo: espalhar os agentes evita 429 em cada avaliação.
GROQ_MODEL_MANUTENCAO=openai/gpt-oss-20b
GROQ_MODEL_PRODUCAO=qwen/qwen3.8-27b
GROQ_MODEL_ENERGIA=openai/gpt-oss-20b
# A chave da API Groq é cadastrada como credencial dentro do n8n (T17), não aqui.

# ---------------------------------------------------------------------------
# E-mail (Gmail SMTP com senha de app) - usado pelos workflows de ação (T08)
# ---------------------------------------------------------------------------
EMAIL_REMETENTE=seu_email@gmail.com
EMAIL_DESTINO=seu_email@gmail.com

# ---------------------------------------------------------------------------
# Telegram / Trello - ids usados pelos workflows de ação (T08)
# ---------------------------------------------------------------------------
TELEGRAM_CHAT_ID=coloque_o_chat_id_aqui
TRELLO_LIST_ID=coloque_o_id_da_lista_trello_aqui

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=fabrica_iot
MYSQL_USER=cp5_app
MYSQL_PASSWORD=troque_esta_senha
MYSQL_ROOT_PASSWORD=troque_esta_senha_root

# ---------------------------------------------------------------------------
# Mosquitto (MQTT) - usado para gerar o password_file automaticamente
# ---------------------------------------------------------------------------
MQTT_USER=cp5_mqtt
MQTT_PASSWORD=troque_esta_senha_mqtt

# Chave da Groq (console.groq.com/keys). Importada no n8n por n8n/credentials/importar_groq.sh
GROQ_API_KEY=

# Redes com inspeção HTTPS (laboratórios FIAP): rode infra/certs/exportar_ca_fiap.ps1
# e aponte para o bundle gerado. Em outras redes, deixe vazio.
NODE_EXTRA_CA_CERTS=

# Segredos das ações (WF-30). Importados no n8n por n8n/credentials/importar_integracoes.sh
# Telegram: token do @BotFather
TELEGRAM_BOT_TOKEN=
# Gmail: senha de app de 16 caracteres, sem espaços (myaccount.google.com/apppasswords).
# Observação: a rede da FIAP bloqueia SMTP de saída (portas 465 e 587).
GMAIL_APP_PASSWORD=
# Trello: API Key do Power-Up (trello.com/power-ups/admin) e o token gerado a partir dela
TRELLO_API_KEY=
TRELLO_TOKEN=
