# CP5 - Variáveis de ambiente (infra Docker)
# Copie este arquivo para `.env` e preencha com valores locais/reais.
# NUNCA versione o arquivo `.env` (veja .gitignore).

# ---------------------------------------------------------------------------
# Execução / segurança
# ---------------------------------------------------------------------------
# Com DRY_RUN=true as ações (Telegram/E-mail/Trello) gravam em `acoes_log`
# em vez de chamar as APIs externas. Use DRY_RUN=false só no smoke real (T18).
DRY_RUN=true

# ---------------------------------------------------------------------------
# LLM (Groq) - nomes de modelo ficam em env para troca rápida (decisão §8.2)
# ---------------------------------------------------------------------------
GROQ_MODEL_SUPERVISOR=llama-3.3-70b-versatile
GROQ_MODEL_ESPECIALISTA=llama-3.1-8b-instant
# A chave da API Groq é cadastrada como credencial dentro do n8n (T17), não aqui.

# ---------------------------------------------------------------------------
# E-mail (Gmail SMTP com senha de app) - usado pelos workflows de ação (T08)
# ---------------------------------------------------------------------------
EMAIL_REMETENTE=seu_email@gmail.com
EMAIL_DESTINO=seu_email@gmail.com

# ---------------------------------------------------------------------------
# Telegram / Trello - ids usados pelos workflows de ação (T08)
# ---------------------------------------------------------------------------
TELEGRAM_CHAT_ID=coloque_o_chat_id_aqui
TRELLO_LIST_ID=coloque_o_id_da_lista_trello_aqui

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=fabrica_iot
MYSQL_USER=cp5_app
MYSQL_PASSWORD=troque_esta_senha
MYSQL_ROOT_PASSWORD=troque_esta_senha_root

# ---------------------------------------------------------------------------
# Mosquitto (MQTT) - usado para gerar o password_file automaticamente
# ---------------------------------------------------------------------------
MQTT_USER=cp5_mqtt
MQTT_PASSWORD=troque_esta_senha_mqtt

# Chave da Groq (console.groq.com/keys). Importada no n8n por n8n/credentials/importar_groq.sh
GROQ_API_KEY=
